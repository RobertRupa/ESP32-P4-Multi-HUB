{
    "write_flash_args" : [ "--flash_mode", "dio",
                           "--flash_size", "16MB",
                           "--flash_freq", "80m" ],
    "flash_settings" : {
        "flash_mode": "dio",
        "flash_size": "16MB",
        "flash_freq": "80m"
    },
    "flash_files" : {
        "0x2000" : "bootloader/bootloader.bin",
        "0x20000" : "$<TARGET_PROPERTY:__idf_build_target,EXECUTABLE_NAME>.bin",
        "0x11000" : "partition_table/partition-table.bin"
    },
    "bootloader" : { "offset" : "0x2000", "file" : "bootloader/bootloader.bin", "encrypted" : "true" },
    "app" : { "offset" : "0x20000", "file" : "$<TARGET_PROPERTY:__idf_build_target,EXECUTABLE_NAME>.bin", "encrypted" : "true" },
    "partition-table" : { "offset" : "0x11000", "file" : "partition_table/partition-table.bin", "encrypted" : "true" },
    "extra_esptool_args" : {
        "after"  : "no_reset",
        "before" : "default_reset",
        "stub"   : true,
        "chip"   : "esp32p4"
    }
}
